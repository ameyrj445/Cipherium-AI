# =============================================================================
# Cipherium AI - Frontend Environment Configuration (.env.example)
# =============================================================================
# Instructions:
# 1. Copy this file to `.env` in the frontend directory:
#      cp .env.example .env
# 2. Update the environment variables below for your local environment.
# =============================================================================

# Backend API Base URL:
# Set this to the URL where your FastAPI backend server is accessible.
# Default for local development: http://127.0.0.1:8000
VITE_API_URL=http://127.0.0.1:8000

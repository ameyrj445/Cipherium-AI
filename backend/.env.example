# =============================================================================
# Cipherium AI - Backend Environment Configuration (.env.example)
# =============================================================================
# Instructions:
# 1. Copy this file to `.env` in the backend directory:
#      cp .env.example .env
# 2. Update the environment variables below for your local environment.
# =============================================================================

# Application Environment: 'development', 'production', or 'test'
ENVIRONMENT=development

# Database Connection:
# - Default for local development (SQLite zero-configuration):
DATABASE_URL=sqlite:///./cipherium.db
# - PostgreSQL example for production / Docker:
# DATABASE_URL=postgresql+psycopg://cipherium_user:your_password@localhost:5432/cipherium_ai

# JWT Authentication:
# Replace with a cryptographically secure random string in production:
# e.g., generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_secret_key_minimum_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Google Gemini AI Integration (Optional):
# Enables AI Tutor explanations and personalized AI Study Plan generation.
# If omitted or left blank, the app gracefully falls back to rule-based logic.
# Obtain an API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# CORS Allowed Origins:
# Comma-separated list of frontend client origins permitted to access this API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost
